# ── Chain ──────────────────────────────────────────────────────────────────────
SETTLEMENT_CONTRACT=0x...        # SandboxServing BeaconProxy address — broker reads
                                  # services()/balance() against this contract.
TAPP_REGISTRY=0x...               # TappRegistry address — broker verifies that the
                                  # signer recovered from each incoming session
                                  # request is an active node of the provider's
                                  # appId via tapp.getNode(appId, signer).
CHAIN_ID=16602
RPC_URL=https://evmrpc-testnet.0g.ai

# ── TEE key ───────────────────────────────────────────────────────────────────
# Production: fetched automatically from tapp-daemon over gRPC.
# Development: set MOCK_TEE=true and MOCK_APP_PRIVATE_KEY instead.
BACKEND_TAPP_IP=host.docker.internal
BACKEND_TAPP_PORT=50051
BACKEND_APP_NAME=0g-broker       # tapp appId for the broker itself — must match
                                  # the value used when starting the broker app
                                  # via `tapp-cli start-app --app-id ...`.

# MOCK_TEE=true
# MOCK_APP_PRIVATE_KEY=0x<hex>

# ── Redis ─────────────────────────────────────────────────────────────────────
BROKER_REDIS_PASSWORD=

# ── Balance monitor ───────────────────────────────────────────────────────────
BROKER_PORT=8080
BROKER_MONITOR_INTERVAL_SEC=30    # how often to poll user balances on-chain
BROKER_TOPUP_INTERVALS=6          # top-up amount = price_per_sec × voucher_interval × this
BROKER_THRESHOLD_INTERVALS=2      # trigger top-up when remaining < this × voucher_interval

# ── Payment layer ─────────────────────────────────────────────────────────────
PAYMENT_LAYER_URL=                # empty = noop (log-only, top-up manually)
BROKER_DEPOSIT_POLL_INTERVAL_SEC=5
BROKER_DEPOSIT_POLL_TIMEOUT_SEC=120

# ── Debug ─────────────────────────────────────────────────────────────────────
BROKER_DEBUG=false                # set true to expose GET /api/monitor
