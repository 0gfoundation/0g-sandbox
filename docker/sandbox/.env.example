# ── Billing proxy ─────────────────────────────────────────────────────────────
# Sandbox proxy image. Set to a registry the host can reach; unset falls back to
# the aliyun VPC ref (only reachable inside that VPC). For GCP CVMs use the GCP
# Artifact Registry copy, e.g.:
#   SANDBOX_IMAGE=us-central1-docker.pkg.dev/g-devops/zg-sandbox/0g-sandbox:sandbox
# Pull auth for private registries is set up out-of-band via `tapp-cli docker-login`
# (for AR: user oauth2accesstoken, password = `gcloud auth print-access-token`).
SANDBOX_IMAGE=

# DAYTONA_API_URL is hardcoded in docker-compose.yml (http://api:3000).
# Do NOT set it here — Daytona must not be reachable from outside the stack.
DAYTONA_ADMIN_KEY=          # Daytona admin API key (set in Daytona's ADMIN_API_KEY)

REDIS_PASSWORD=             # billing Redis password (leave blank for no auth in dev)

# TEE / Chain
# Production: TEE key is fetched automatically from tapp-daemon via gRPC (BACKEND_TAPP_IP/PORT/APP_NAME).
# Development: set MOCK_TEE=true and MOCK_APP_PRIVATE_KEY instead.
PROVIDER_ADDRESS=           # REQUIRED — on-chain provider wallet (the address registered via `cmd/provider register`)
ADMIN_ADDRESSES=            # comma-separated operator wallets allowed to call admin-only /api/* endpoints
                            # (snapshot/registry mgmt, archive-all, force-delete, sessions, audit-log).
                            # Empty = falls back to [PROVIDER_ADDRESS] for single-key deployments.
SETTLEMENT_CONTRACT=0x...   # BeaconProxy address (output of `go run ./cmd/deploy/`)
TAPP_REGISTRY=0x...         # TappRegistry address (passed to ./cmd/deploy/ --tapp).
                            # Required: SandboxServing delegates TEE signer identity
                            # and user acknowledgement to this contract.
CHAIN_ID=16602
RPC_URL=https://evmrpc-testnet.0g.ai

# Billing parameters (all amounts in neuron; 1 0G = 10^18 neuron)
COMPUTE_PRICE_PER_SEC=16667 # neuron/sec per open sandbox (≈ 1M neuron/min)
CREATE_FEE=5000000          # neuron flat fee on sandbox creation
VOUCHER_INTERVAL_SEC=3600   # how often to flush compute vouchers to chain (seconds)

PORT=8080

# Sealed-only gate. When true, every POST /api/sandbox without "sealed": true
# is rejected with HTTP 400 (before any billing/Daytona work). Leave false to
# accept both sealed and normal sandboxes. Surfaced via GET /api/info.
SEALED_ONLY=false

# Snapshot used when a create request omits one. Daytona forbids deleting the
# default snapshot, so point this at a known-good snapshot (a sealed-only
# provider should use its sealed snapshot here).
DEFAULT_SNAPSHOT=daytonaio/sandbox:0.5.0-slim

# tapp-daemon gRPC endpoint — billing fetches its TEE key from here at startup
# (production path; skipped when MOCK_TEE is set).
BACKEND_TAPP_IP=host.docker.internal
BACKEND_TAPP_PORT=50051
BACKEND_APP_NAME=                # tapp appId — must match the value used in
                                  # `tapp-cli start-app --app-id ...` and the appId
                                  # registered on-chain via tapp's `register-onchain`.

# Local development only — do NOT set in production
# MOCK_TEE=true
# MOCK_APP_PRIVATE_KEY=0x<hex-private-key>

# Daytona api/proxy images. Default: official v0.189.0. Point at the
# 0g-daytona fork images to enable publicPorts (per-port public preview) —
# with official images, creates that request publicPorts are rejected (502).
# DAYTONA_API_IMAGE=us-central1-docker.pkg.dev/g-devops/zg-sandbox/daytona-api:v0.189.0-0g.1
# DAYTONA_PROXY_IMAGE=us-central1-docker.pkg.dev/g-devops/zg-sandbox/daytona-proxy:v0.189.0-0g.1

# ── Daytona internals ─────────────────────────────────────────────────────────
# These have safe defaults for local dev. Change in production.
DAYTONA_ENCRYPTION_KEY=supersecretkey
DAYTONA_ENCRYPTION_SALT=supersecretsalt
DAYTONA_DB_USER=user
DAYTONA_DB_PASSWORD=pass
DAYTONA_DB_NAME=daytona
DAYTONA_RUNNER_API_KEY=secret_api_token
DAYTONA_PROXY_API_KEY=super_secret_key
DAYTONA_SSH_GATEWAY_API_KEY=ssh_secret_api_token
# SSH gateway key pair — generate once per deployment (see README for commands)
DAYTONA_SSH_GATEWAY_PRIVATE_KEY=   # base64-encoded OpenSSH ed25519 private key
DAYTONA_SSH_GATEWAY_HOST_KEY=      # base64-encoded OpenSSH ed25519 host key (can reuse PRIVATE_KEY)
DAYTONA_SSH_GATEWAY_PUBLIC_KEY=    # base64-encoded OpenSSH ed25519 public key (matches PRIVATE_KEY)
DAYTONA_HEALTH_CHECK_API_KEY=supersecretkey
DAYTONA_REGISTRY_PASSWORD=password # internal/transient registry password

# MinIO (sandbox object storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Domain for sandbox HTTP port forwarding (Daytona proxy)
# Local: proxy.localhost:4000
# Production: your actual wildcard domain, e.g. proxy.example.com:4000
PROXY_DOMAIN=proxy.localhost:4000

# Scheme of the preview URLs returned to users (default http).
# Set to https when TLS terminates in front of the Daytona proxy — requires a
# wildcard cert for *.<PROXY_DOMAIN> (the <port>-<sandboxId> prefix is a single
# label, so one wildcard level covers it) and PROXY_DOMAIN without a port.
#PROXY_PROTOCOL=https

# Runner domain (hostname where runner is reachable for sandbox networking)
# Local: localhost  Production: actual hostname/IP
RUNNER_DOMAIN=runner

# Runner capacity SEED values (optional). NOTE: the daytona-runner auto-detects
# the host's real CPU/MEM/DISK and registers those, so MEM/DISK overrides here
# are effectively ignored, and the scheduler does not hard-cap concurrency.
# Leave unset unless you know you need them; to actually bound concurrent
# sandboxes use org quotas (see DEFAULT_REGION_ENFORCE_QUOTAS in compose).
# DEFAULT_RUNNER_CPU=4
# DEFAULT_RUNNER_MEMORY=8
# DEFAULT_RUNNER_DISK=50

# SSH gateway host advertised to the CLI `ssh-access` command. The Web UI uses
# window.location.hostname, so this only matters for CLI users. Empty = not
# advertised. Production: your sandbox host's public domain/IP.
SSH_GATEWAY_HOST=

# Broker URL — billing notifies the broker of session open/close for balance
# monitoring. Empty = broker integration disabled.
BROKER_URL=

# ── Volume name overrides (optional; compose has defaults) ──────────────────
# Set per-environment to isolate data between deployments on the same host.
# IMPORTANT: the docker-compose project name also prefixes these — renaming the
# tapp app-id changes the prefix and will mount fresh (empty) volumes.
DB_DATA_VOLUME=db_data_prod
SANDBOX_REDIS_DATA=sandbox_redis_data
DAYTONA_REDIS_DATA=daytona_redis_data
DEX_DB_DATA=dex_db
MINIO_DATA=minio_data
